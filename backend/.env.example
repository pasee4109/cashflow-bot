# ── Core ────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true

# Sign JWTs & the OAuth session cookie. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Fernet key for encrypting stored Settrade secrets at rest.
# Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# If left blank, a key is derived from SECRET_KEY (fine for dev, set a real one in prod).
APP_ENCRYPTION_KEY=

# ── Google Sign-In (OAuth 2.0 / OIDC) ───────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI must match OAUTH_REDIRECT_URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Allow a password-less dev login while Google is not configured (local only).
ALLOW_DEV_LOGIN=true

# ── URLs / cookies ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ── Database ────────────────────────────────────────────────────────
# Default is SQLite under backend/data/. For Postgres:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/cashflow
# DATABASE_URL=sqlite:///./data/app.db

# ── Monitor ─────────────────────────────────────────────────────────
ORDER_POLL_INTERVAL_SEC=5
HEARTBEAT_INTERVAL_SEC=60
